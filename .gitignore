node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# 2. 构建产物与编译输出 (Build & Compilation Outputs)
# ==========================================
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.rollup.cache/

# ==========================================
# 3. 环境变量与敏感凭据 (Environment Variables & Secrets)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 4. 数据库与 ORM 生成产物 (Database & ORM Generated)
# ==========================================
/src/generated/prisma
/backend/src/generated/prisma
*.sqlite
*.sqlite3
*.db

# ==========================================
# 5. 用户上传媒体文件 (User Uploads)
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ==========================================
# 6. 测试产物与覆盖率报告 (Testing & Coverage)
# ==========================================
coverage/
.vitest/
.nyc_output/

# ==========================================
